<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] : "Windows & Linux Cloud Server Hosting in India | SuperCloudServer")</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Get a Windows or Linux cloud server on dedicated hardware, deployed in minutes. Instant scaling, 24x7 support and a 30-day money-back guarantee. Plans from ₹250/month.")" />
    <meta name="keywords" content="cloud server hosting, windows cloud hosting, linux cloud hosting, cloud server hosting providers India, dynamic cloud servers, cloud web hosting, scalable cloud server, managed cloud server" />
    <meta name="author" content="SuperCloudServer / Celexsa Technologies" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Windows & Linux Cloud Server Hosting in India | SuperCloudServer" />
    <meta property="og:description" content="Launch high-performance private cloud servers with automatic failover, RAID-1 storage, and 24x7x365 support. Starting at ₹250/mo." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://supercloudserver.com" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Announcement Bar -->
    <div class="top-announcement">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-shield-check text-success me-1"></i> Dedicated Hardware, Never Shared</span>
                <span class="d-none d-md-inline text-secondary">|</span>
                <span class="d-none d-md-inline"><i class="bi bi-clock-history text-info me-1"></i> 30-Day Money-Back Guarantee</span>
                <span class="d-none d-lg-inline text-secondary">|</span>
                <span class="d-none d-lg-inline"><i class="bi bi-activity text-warning me-1"></i> 99.99% Uptime SLA</span>
            </div>
            <div class="d-flex align-items-center gap-3 ms-auto">
                <a href="tel:+917401666633" class="text-light fw-bold"><i class="bi bi-telephone-fill text-primary me-1"></i> +91 7401 6666 33</a>
                <span class="text-secondary">|</span>
                <div class="btn-group btn-group-sm" role="group" aria-label="Currency Switcher">
                    <button type="button" class="btn btn-primary btn-sm px-2 py-0 currency-toggle-btn active" data-currency="INR">₹ INR</button>
                    <button type="button" class="btn btn-outline-primary btn-sm px-2 py-0 currency-toggle-btn text-white" data-currency="USD">$ USD</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-xl scs-navbar">
            <div class="container">
                <a class="navbar-brand scs-brand" asp-controller="Home" asp-action="Index">
                    <span class="scs-brand-icon">
                        <i class="bi bi-cloud-arrow-up-fill"></i>
                    </span>
                    <span class="scs-brand-text">
                        <span class="scs-brand-title">Super<span>Cloud</span>Server</span>
                        <span class="scs-brand-badge">Powered by Celexsa</span>
                    </span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#scsNavbar" aria-controls="scsNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="scsNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-xl-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Overview</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#plans">Cloud Plans</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#features">Features</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#platform-choice">Linux vs Windows</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#compare">Cloud vs VPS</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#calculator">Configurator</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#faq">FAQs</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <a href="tel:+917401666633" class="btn btn-outline-scs d-none d-lg-inline-flex py-2 px-3 fs-6">
                            <i class="bi bi-headset"></i> 24x7 Sales
                        </a>
                        <a href="#get-started" class="btn btn-primary-scs py-2 px-3 fs-6">
                            <span>Get Started</span> <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Page Body -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Comprehensive Enterprise Footer -->
    <footer class="scs-footer">
        <div class="container">
            <div class="row g-4 mb-5">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="scs-brand-icon">
                            <i class="bi bi-cloud-arrow-up-fill"></i>
                        </span>
                        <div class="scs-brand-text">
                            <span class="scs-brand-title text-white">Super<span class="text-primary">Cloud</span>Server</span>
                            <span class="scs-brand-badge text-muted">A Celexsa Technologies Initiative</span>
                        </div>
                    </div>
                    <p class="text-secondary small pe-lg-4 mb-3">
                        SuperCloudServer delivers resilient, private cloud servers with dedicated CPU and RAM, instant automatic failover, mirrored RAID 1 storage, and 24x7x365 human engineering support.
                    </p>
                    <div class="d-flex align-items-center gap-2 text-secondary small">
                        <i class="bi bi-geo-alt-fill text-primary"></i> Celexsa Technologies, Chennai, India
                    </div>
                    <div class="d-flex align-items-center gap-2 text-secondary small mt-1">
                        <i class="bi bi-telephone-fill text-primary"></i> Direct Sales: +91 7401 6666 33
                    </div>
                    <div class="d-flex align-items-center gap-2 text-secondary small mt-1">
                        <i class="bi bi-envelope-fill text-primary"></i> contact@supercloudserver.com
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h5 class="footer-heading">Cloud Hosting</h5>
                    <ul class="footer-links">
                        <li><a href="#plans" class="select-plan-trigger" data-platform="Linux" data-plan="1 GB (₹250/month)">Linux Cloud 1 GB</a></li>
                        <li><a href="#plans" class="select-plan-trigger" data-platform="Linux" data-plan="20 GB (₹500/month)">Linux Corporate 20 GB</a></li>
                        <li><a href="#plans" class="select-plan-trigger" data-platform="Linux" data-plan="Unlimited (₹2,500/month)">Linux Unlimited</a></li>
                        <li><a href="#plans" class="select-plan-trigger" data-platform="Windows" data-plan="1 GB (₹250/month)">Windows Cloud 1 GB</a></li>
                        <li><a href="#plans" class="select-plan-trigger" data-platform="Windows" data-plan="20 GB (₹500/month)">Windows Corporate 20 GB</a></li>
                        <li><a href="#plans" class="select-plan-trigger" data-platform="Windows" data-plan="Unlimited (₹2,500/month)">Windows Unlimited</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h5 class="footer-heading">Technical Specs</h5>
                    <ul class="footer-links">
                        <li><a href="#features">Mirrored RAID-1 Storage</a></li>
                        <li><a href="#features">Automatic Node Failover</a></li>
                        <li><a href="#features">cPanel & Plesk Integration</a></li>
                        <li><a href="#security">ClamAV & SpamAssassin</a></li>
                        <li><a href="#compare">Cloud vs. VPS vs. Shared</a></li>
                        <li><a href="#platform-choice">Linux vs. Windows Stacks</a></li>
                        <li><a href="#calculator">Cloud Price Calculator</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-heading">Trust & Assurance</h5>
                    <p class="small text-secondary mb-3">
                        Backed by Celexsa's enterprise SLA with 100% genuine dedicated hardware, redundant uplinks, and verified GST invoicing.
                    </p>
                    <div class="bg-dark p-3 rounded-3 border border-secondary border-opacity-25 mb-3">
                        <div class="d-flex align-items-center gap-2 text-white small fw-bold mb-1">
                            <i class="bi bi-shield-lock-fill text-success"></i> 30-Day Money-Back Guarantee
                        </div>
                        <div class="text-secondary small" style="font-size: 0.78rem;">
                            Test our cloud performance risk-free. Full refund available within 30 days.
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25 px-2 py-1">ISO 27001</span>
                        <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25 px-2 py-1">Tier-III DC</span>
                        <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25 px-2 py-1">GST Ready</span>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <div>
                    &copy; @DateTime.UtcNow.Year SuperCloudServer. All rights reserved. A brand of Celexsa Technologies.
                </div>
                <div class="d-flex gap-3 mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy" class="text-secondary small">Privacy Policy</a>
                    <a href="#faq" class="text-secondary small">FAQ</a>
                    <a href="#get-started" class="text-secondary small">Get Started</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
