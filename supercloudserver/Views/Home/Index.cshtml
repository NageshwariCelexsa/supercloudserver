                    <p>Our expert technicians transfer your files, databases, and emails from your existing host completely free of charge.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     6. CHOOSE YOUR LEVEL OF MANAGEMENT
     ========================================================================= -->
<section class="py-5" id="management">
    <div class="container py-4">
        <div class="section-header">
            <span class="section-tag">Tailored Operations</span>
            <h2 class="section-title">Choose Your Level of Management</h2>
            <p class="section-subtitle">
                Whether you want complete administrative autonomy or prefer our senior cloud engineers to handle maintenance, we have you covered.
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            <!-- Self-Managed -->
            <div class="col-lg-5 col-md-6">
                <div class="mgmt-card self-managed">
                    <span class="mgmt-badge self">Self-Managed</span>
