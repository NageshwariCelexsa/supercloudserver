@model supercloudserver.Models.HomeViewModel
@{
    ViewData["Title"] = "Windows & Linux Cloud Server Hosting in India | SuperCloudServer";
    ViewData["MetaDescription"] = "Get a Windows or Linux cloud server on dedicated hardware, deployed in minutes. Instant scaling, 24x7 support and a 30-day money-back guarantee. Plans from ₹250/month.";
}

<!-- =========================================================================
     1. HERO SECTION
     ========================================================================= -->
<section class="hero-section" id="overview">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="hero-pill">
                    <i class="bi bi-rocket-takeoff-fill"></i> Next-Gen Enterprise Cloud Infrastructure
                </div>
                <h1 class="hero-title">
                    Cloud Servers That <span class="text-primary">Grow When You Do</span>
                </h1>
                <p class="hero-subtitle">
                    Launch a powerful, private cloud server in minutes. Pick the resources you need today, add more tomorrow, and pay only for what you use.
                </p>

                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a href="#plans" class="btn btn-primary-scs fs-6">
                        <i class="bi bi-grid-fill"></i> View Cloud Plans
                    </a>
                    <a href="#get-started" class="btn btn-outline-scs fs-6">
                        <i class="bi bi-chat-dots-fill"></i> Talk to a Cloud Expert
                    </a>
                </div>

                <div class="hero-trust-bar">
                    <div class="hero-trust-item">
                        <i class="bi bi-shield-check"></i> 30-Day Money-Back Guarantee
                    </div>
                    <div class="hero-trust-item">
                        <i class="bi bi-clock-fill"></i> 24x7x365 Priority Support
                    </div>
                    <div class="hero-trust-item">
                        <i class="bi bi-cpu-fill"></i> Dedicated Hardware, Never Shared
                    </div>
                    <div class="hero-trust-item">
                        <i class="bi bi-check2-circle"></i> 99.99% Uptime SLA
                    </div>
                </div>
            </div>

            <!-- Interactive Live Server Visualizer -->
            <div class="col-lg-6">
                <div class="server-dashboard-card">
                    <div class="server-header">
                        <div class="d-flex align-items-center gap-2">
                            <span class="server-status-dot"></span>
                            <span class="fw-bold fs-6">Cloud Node Cluster: ACTIVE</span>
                        </div>
                        <span class="badge bg-primary bg-opacity-25 text-info border border-info border-opacity-25 px-2 py-1">
                            <i class="bi bi-hdd-network-fill me-1"></i> RAID 1 Mirrored
                        </span>
                    </div>

                    <div class="metric-gauge-box">
                        <div class="metric-label">
                            <span>Dedicated vCPU (High Frequency)</span>
                            <span id="hero-cpu-text" class="text-info fw-bold">18%</span>
                        </div>
                        <div class="metric-progress">
                            <div class="metric-bar" id="hero-cpu-bar" style="width: 18%;"></div>
                        </div>
                    </div>

                    <div class="metric-gauge-box">
                        <div class="metric-label">
                            <span>Reserved RAM (Zero Throttling)</span>
                            <span id="hero-ram-text" class="text-success fw-bold">42%</span>
                        </div>
                        <div class="metric-progress">
                            <div class="metric-bar bg-success" id="hero-ram-bar" style="width: 42%;"></div>
                        </div>
                    </div>

                    <div class="metric-gauge-box">
                        <div class="metric-label">
                            <span>Enterprise NVMe Read/Write Speed</span>
                            <span class="text-warning fw-bold">3,500 MB/s</span>
                        </div>
                        <div class="metric-progress">
                            <div class="metric-bar bg-warning" style="width: 85%;"></div>
                        </div>
                    </div>

                    <div class="metric-gauge-box mb-0">
                        <div class="metric-label">
                            <span>Automatic Failover Health Monitor</span>
                            <span class="text-success fw-bold">100% Redundant</span>
                        </div>
                        <div class="metric-progress">
                            <div class="metric-bar bg-info" style="width: 100%;"></div>
                        </div>
                    </div>

                    <div class="server-feature-tags">
                        <span class="server-tag"><i class="bi bi-cpu"></i> Intel Xeon / AMD EPYC</span>
                        <span class="server-tag"><i class="bi bi-shield-shaded"></i> ClamAV & Anti-Spam</span>
                        <span class="server-tag"><i class="bi bi-terminal"></i> cPanel / Plesk</span>
                        <span class="server-tag"><i class="bi bi-arrow-repeat"></i> Auto-Failover</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     2. WHY CHOOSE SUPERCLOUDSERVER (KEY BENEFITS)
     ========================================================================= -->
<section class="py-5" id="benefits">
    <div class="container py-4">
        <div class="section-header">
            <span class="section-tag">Engineered for Reliability</span>
            <h2 class="section-title">Why Choose SuperCloudServer Cloud Servers?</h2>
            <p class="section-subtitle">
                Built on isolated enterprise hardware and high-speed network meshes, our cloud instances offer the responsiveness of dedicated servers at cloud-native flexibility.
            </p>
        </div>

        <div class="row g-4">
            <!-- Benefit 1 -->
            <div class="col-lg-4 col-md-6">
                <div class="benefit-card">
                    <div class="benefit-icon-wrapper">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <h4>Performance without the wait</h4>
                    <p>
                        Your workloads run on fast SSD/NVMe storage and modern processors, so pages load quickly and applications stay responsive even at peak hours.
                    </p>
                </div>
            </div>

            <!-- Benefit 2 -->
            <div class="col-lg-4 col-md-6">
                <div class="benefit-card">
                    <div class="benefit-icon-wrapper">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>
                    <h4>Resources that are truly yours</h4>
                    <p>
                        CPU and RAM are reserved for your server, so a busy neighbour never slows you down. Zero resource contention and guaranteed throughput.
                    </p>
                </div>
            </div>

            <!-- Benefit 3 -->
            <div class="col-lg-4 col-md-6">
                <div class="benefit-card">
                    <div class="benefit-icon-wrapper">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h4>Scale in a few clicks</h4>
                    <p>
                        Need more power for a sale, a launch or a busy season? Increase CPU, memory or storage from your dashboard, with no rebuild and no lengthy downtime.
                    </p>
                </div>
            </div>

            <!-- Benefit 4 -->
            <div class="col-lg-4 col-md-6">
                <div class="benefit-card">
                    <div class="benefit-icon-wrapper">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h4>Built-in protection</h4>
                    <p>
                        Firewall controls, regular backups, ClamAV antivirus and continuous monitoring keep your data safe and your services online around the clock.
                    </p>
                </div>
            </div>

            <!-- Benefit 5 -->
            <div class="col-lg-4 col-md-6">
                <div class="benefit-card">
                    <div class="benefit-icon-wrapper">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h4>Real people, any hour</h4>
                    <p>
                        Our support engineers are available around the clock to help with setup, tuning and troubleshooting via phone, ticket, and live chat.
                    </p>
                </div>
            </div>

            <!-- Benefit 6 (Celexsa Enterprise Grade) -->
            <div class="col-lg-4 col-md-6">
                <div class="benefit-card">
                    <div class="benefit-icon-wrapper">
                        <i class="bi bi-layers-fill"></i>
                    </div>
                    <h4>Automatic Hardware Failover</h4>
                    <p>
                        Pooled dedicated nodes monitor each other continuously. If any physical machine encounters an issue, your workload moves automatically without disruption.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     3. PLANS AND PRICING (LINUX & WINDOWS)
     ========================================================================= -->
<section class="pricing-section" id="plans">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Transparent Indian & Global Pricing</span>
            <h2 class="section-title">Cloud Server Plans</h2>
            <p class="section-subtitle">
                Clear, honest pricing with single-domain dedicated resource allocations. Choose Linux or Windows with instant deployment and a 30-day money-back guarantee.
            </p>
        </div>

        <!-- Platform Switcher Pill -->
        <div class="platform-switcher-container">
            <div class="platform-pill-toggle">
                <button type="button" class="platform-btn @(Model.ActivePlatformTab == "Linux" ? "active" : "")" data-platform="Linux">
                    <i class="bi bi-ubuntu"></i> Linux Cloud Servers
                </button>
                <button type="button" class="platform-btn @(Model.ActivePlatformTab == "Windows" ? "active" : "")" data-platform="Windows">
                    <i class="bi bi-windows"></i> Windows Cloud Servers
                </button>
            </div>
        </div>

        <!-- Billing Cycle & Currency Switcher -->
        <div class="currency-cycle-controls">
            <div class="cycle-toggle">
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="radio" name="billingCycle" id="cycleMonthly" value="monthly" checked>
                    <label class="form-check-label fw-bold" for="cycleMonthly">Monthly Billing</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="radio" name="billingCycle" id="cycleAnnual" value="annual">
                    <label class="form-check-label fw-bold" for="cycleAnnual">Annual Billing</label>
                </div>
                <span class="discount-badge">Save 15% on Annual</span>
            </div>
        </div>

        <!-- LINUX PLANS VIEW -->
        <div id="linux-plans-view" class="@(Model.ActivePlatformTab == "Linux" ? "" : "d-none")">
            <div class="row g-4 justify-content-center">
                @foreach (var plan in Model.LinuxPlans)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="pricing-card @(plan.IsPopular ? "featured" : "")">
                            @if (plan.IsPopular)
                            {
                                <span class="featured-badge">Most Popular</span>
                            }
                            <div class="plan-header">
                                <h3 class="plan-name">@plan.Name</h3>
                                <p class="plan-tagline">@plan.Tagline</p>

                                <div class="plan-price-box" 
                                     data-inr-monthly="@plan.PriceMonthlyInr" 
                                     data-inr-annual="@plan.PriceAnnualInr"
                                     data-usd-monthly="@plan.PriceMonthlyUsd"
                                     data-usd-annual="@plan.PriceAnnualUsd">
                                    <span class="plan-currency">₹</span>
                                    <span class="plan-amount">@plan.PriceMonthlyInr.ToString("N0")</span>
                                    <span class="plan-period">/ month</span>
                                </div>

                                <div class="plan-specs-summary">
                                    <div class="spec-item">
                                        <span class="spec-label">Disk Space</span>
                                        <span class="spec-val">@plan.DiskSpace</span>
                                    </div>
                                    <div class="spec-item">
                                        <span class="spec-label">Bandwidth</span>
                                        <span class="spec-val">@plan.DataTransfer</span>
                                    </div>
                                    <div class="spec-item">
                                        <span class="spec-label">Email</span>
                                        <span class="spec-val">@plan.EmailAccounts</span>
                                    </div>
                                </div>
                            </div>

                            <ul class="plan-features-list">
                                @foreach (var feat in plan.Highlights)
                                {
                                    <li>
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span>@feat</span>
                                    </li>
                                }
                            </ul>

                            <button type="button" 
                                    class="btn @(plan.IsPopular ? "btn-primary-scs" : "btn-outline-scs") w-100 justify-content-center select-plan-trigger" 
                                    data-platform="Linux" 
                                    data-plan="@plan.Name (@(plan.DiskSpace))">
                                <span>Configure & Deploy</span> <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- WINDOWS PLANS VIEW -->
        <div id="windows-plans-view" class="@(Model.ActivePlatformTab == "Windows" ? "" : "d-none")">
            <div class="row g-4 justify-content-center">
                @foreach (var plan in Model.WindowsPlans)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="pricing-card @(plan.IsPopular ? "featured" : "")">
                            @if (plan.IsPopular)
                            {
                                <span class="featured-badge">Corporate Standard</span>
                            }
                            <div class="plan-header">
                                <h3 class="plan-name">@plan.Name</h3>
                                <p class="plan-tagline">@plan.Tagline</p>

                                <div class="plan-price-box" 
                                     data-inr-monthly="@plan.PriceMonthlyInr" 
                                     data-inr-annual="@plan.PriceAnnualInr"
                                     data-usd-monthly="@plan.PriceMonthlyUsd"
                                     data-usd-annual="@plan.PriceAnnualUsd">
                                    <span class="plan-currency">₹</span>
                                    <span class="plan-amount">@plan.PriceMonthlyInr.ToString("N0")</span>
                                    <span class="plan-period">/ month</span>
                                </div>

                                <div class="plan-specs-summary">
                                    <div class="spec-item">
                                        <span class="spec-label">Disk Space</span>
                                        <span class="spec-val">@plan.DiskSpace</span>
                                    </div>
                                    <div class="spec-item">
                                        <span class="spec-label">Bandwidth</span>
                                        <span class="spec-val">@plan.DataTransfer</span>
                                    </div>
                                    <div class="spec-item">
                                        <span class="spec-label">Email</span>
                                        <span class="spec-val">@plan.EmailAccounts</span>
                                    </div>
                                </div>
                            </div>

                            <ul class="plan-features-list">
                                @foreach (var feat in plan.Highlights)
                                {
                                    <li>
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span>@feat</span>
                                    </li>
                                }
                            </ul>

                            <button type="button" 
                                    class="btn @(plan.IsPopular ? "btn-primary-scs" : "btn-outline-scs") w-100 justify-content-center select-plan-trigger" 
                                    data-platform="Windows" 
                                    data-plan="@plan.Name (@(plan.DiskSpace))">
                                <span>Configure & Deploy</span> <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Custom Enterprise Setup Banner -->
        <div class="custom-quote-banner">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <span class="badge bg-primary text-white mb-2 px-3 py-1">Custom Infrastructure</span>
                    <h3 class="fw-bold mb-2 text-white">Need more power, high memory, or dedicated clusters?</h3>
                    <p class="text-secondary mb-0">
                        We build custom high-capacity cloud clusters, multi-node load balanced setups, and dedicated database servers tailored to your specific enterprise traffic.
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a href="#get-started" class="btn btn-primary-scs select-plan-trigger" data-platform="Linux" data-plan="Custom Enterprise Setup">
                        <i class="bi bi-gear-wide-connected"></i> Request Custom Quote
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     4. INTERACTIVE CLOUD RESOURCE CALCULATOR
     ========================================================================= -->
<section class="py-5" id="calculator">
    <div class="container py-4">
        <div class="section-header">
            <span class="section-tag">Instant Resource Sizing</span>
            <h2 class="section-title">Interactive Cloud Price Calculator</h2>
            <p class="section-subtitle">
                Estimate the monthly investment for custom CPU, RAM, and high-speed NVMe storage allocations.
            </p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="calculator-card">
                    <div class="row g-4 align-items-center">
                        <div class="col-lg-7">
                            <!-- vCPU Slider -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="fw-bold fs-6"><i class="bi bi-cpu text-primary me-2"></i> Dedicated vCPU Cores</label>
                                    <span id="calc-cpu-val" class="badge bg-primary px-3 py-2 fs-6">2 vCPUs</span>
                                </div>
                                <input type="range" class="form-range calculator-slider" id="slider-cpu" min="1" max="16" step="1" value="2">
                                <div class="d-flex justify-content-between text-secondary small">
                                    <span>1 Core</span>
                                    <span>4 Cores</span>
                                    <span>8 Cores</span>
                                    <span>16 Cores</span>
                                </div>
                            </div>

                            <!-- RAM Slider -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="fw-bold fs-6"><i class="bi bi-memory text-info me-2"></i> Guaranteed RAM</label>
                                    <span id="calc-ram-val" class="badge bg-info text-dark px-3 py-2 fs-6">4 GB RAM</span>
                                </div>
                                <input type="range" class="form-range calculator-slider" id="slider-ram" min="1" max="64" step="1" value="4">
                                <div class="d-flex justify-content-between text-secondary small">
                                    <span>1 GB</span>
                                    <span>16 GB</span>
                                    <span>32 GB</span>
                                    <span>64 GB</span>
                                </div>
                            </div>

                            <!-- Storage Slider -->
                            <div class="mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="fw-bold fs-6"><i class="bi bi-device-hdd text-warning me-2"></i> Mirrored NVMe SSD Storage</label>
                                    <span id="calc-storage-val" class="badge bg-warning text-dark px-3 py-2 fs-6">50 GB NVMe</span>
                                </div>
                                <input type="range" class="form-range calculator-slider" id="slider-storage" min="10" max="1000" step="10" value="50">
                                <div class="d-flex justify-content-between text-secondary small">
                                    <span>10 GB</span>
                                    <span>250 GB</span>
                                    <span>500 GB</span>
                                    <span>1,000 GB</span>
                                </div>
                            </div>
                        </div>

                        <!-- Price summary column -->
                        <div class="col-lg-5 text-center border-start border-secondary border-opacity-25 ps-lg-4">
                            <span class="text-uppercase small fw-bold text-secondary">Estimated Investment</span>
                            <div class="my-3">
                                <span class="fs-2 fw-bold text-primary" id="calc-currency-symbol">₹</span>
                                <span class="display-4 fw-extrabold text-white" id="calc-total-price">750</span>
                                <span class="text-secondary">/ month</span>
                            </div>
                            <p class="small text-secondary mb-4">
                                Includes automatic node failover, 24x7 monitoring, mirrored RAID-1 storage, and free migration assistance.
                            </p>
                            <button type="button" class="btn btn-primary-scs w-100 justify-content-center" id="calc-apply-btn">
                                <i class="bi bi-check2-circle"></i> Deploy This Custom Config
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     5. WHAT IS INCLUDED WITH EVERY CLOUD SERVER
     ========================================================================= -->
