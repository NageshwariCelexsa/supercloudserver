<!-- =========================================================================
     13. GET STARTED FORM (INTERACTIVE & MODEL-BOUND)
     ========================================================================= -->
<section class="py-5 bg-light" id="get-started">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="form-card">
                    <div class="text-center mb-4">
                        <span class="section-tag">Instant Request</span>
                        <h2 class="fw-bold mb-2">Get Started</h2>
                        <p class="text-secondary">
                            Tell us what you need and our cloud engineering team will set up your server and answer your questions. Fields marked with <span class="text-danger">*</span> are required.
                        </p>
                    </div>

                    <!-- Dynamic Feedback Message Area -->
                    <div id="submitFeedback">
                        @if (!string.IsNullOrEmpty(Model.SubmissionMessage))
                        {
                            <div class="alert @(Model.SubmissionStatus == "SUCCESS" ? "alert-success" : "alert-danger") alert-dismissible fade show p-4 rounded-4 shadow-sm mb-4" role="alert">
                                <div class="d-flex align-items-start gap-3">
                                    <i class="bi @(Model.SubmissionStatus == "SUCCESS" ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-2 flex-shrink-0"></i>
                                    <div>
                                        <h5 class="alert-heading fw-bold mb-1">
                                            @(Model.SubmissionStatus == "SUCCESS" ? "Request Submitted Successfully!" : "Submission Alert")
                                        </h5>
                                        <p class="mb-2">@Model.SubmissionMessage</p>
                                        @if (!string.IsNullOrEmpty(Model.ReferenceCode))
                                        {
                                            <div class="bg-white p-2 px-3 rounded-3 border d-inline-block text-dark fw-bold mb-2">
                                                <small class="text-muted text-uppercase d-block" style="font-size: 0.7rem;">Tracking Reference</small>
                                                <span class="text-primary font-monospace fs-5">@Model.ReferenceCode</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                    </div>

                    <form asp-controller="Home" asp-action="SubmitRequest" method="post" id="getStartedForm">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <!-- Full Name -->
                            <div class="col-md-6">
                                <label asp-for="FormModel.FullName" class="form-label">
                                    Full Name <span class="required-star">*</span>
                                </label>
                                <input asp-for="FormModel.FullName" class="form-control" placeholder="e.g. Rajesh Kumar" required />
                                <span asp-validation-for="FormModel.FullName" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label asp-for="FormModel.Email" class="form-label">
                                    Email Address <span class="required-star">*</span>
                                </label>
                                <input asp-for="FormModel.Email" type="email" class="form-control" placeholder="name@company.com" required />
                                <span asp-validation-for="FormModel.Email" class="text-danger small"></span>
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6">
                                <label asp-for="FormModel.Phone" class="form-label">
                                    Phone Number <span class="required-star">*</span>
                                </label>
                                <input asp-for="FormModel.Phone" type="tel" class="form-control" placeholder="+91 98765 43210" required />
                                <span asp-validation-for="FormModel.Phone" class="text-danger small"></span>
                            </div>

                            <!-- Company -->
                            <div class="col-md-6">
                                <label asp-for="FormModel.Company" class="form-label">
                                    Company / Organization
                                </label>
                                <input asp-for="FormModel.Company" class="form-control" placeholder="e.g. Celexsa Retail Pvt Ltd" />
                                <span asp-validation-for="FormModel.Company" class="text-danger small"></span>
                            </div>

                            <!-- Platform -->
                            <div class="col-md-6">
                                <label asp-for="FormModel.Platform" class="form-label">
                                    Platform <span class="required-star">*</span>
                                </label>
                                <select asp-for="FormModel.Platform" class="form-select" required>
                                    <option value="Linux">Linux Cloud Server (PHP / Python / cPanel)</option>
                                    <option value="Windows">Windows Cloud Server (ASP.NET / MSSQL / IIS)</option>
                                </select>
                                <span asp-validation-for="FormModel.Platform" class="text-danger small"></span>
                            </div>

                            <!-- Plan -->
                            <div class="col-md-6">
                                <label asp-for="FormModel.Plan" class="form-label">
                                    Plan Size <span class="required-star">*</span>
                                </label>
                                <select asp-for="FormModel.Plan" class="form-select" required>
                                    <option value="1 GB (₹250/month)">1 GB (₹250 / month)</option>
                                    <option value="20 GB (₹500/month)">20 GB (₹500 / month) - Recommended</option>
                                    <option value="Unlimited (₹2,500/month)">Unlimited (₹2,500 / month) - Enterprise</option>
                                    <option value="Custom Enterprise Setup">Custom Enterprise Setup (Configurator)</option>
                                </select>
                                <span asp-validation-for="FormModel.Plan" class="text-danger small"></span>
                            </div>

                            <!-- Domain Name -->
                            <div class="col-12">
                                <label asp-for="FormModel.DomainName" class="form-label">
                                    Domain Name
                                </label>
                                <input asp-for="FormModel.DomainName" class="form-control" placeholder="e.g. mycompany.com" />
                                <div class="form-text text-muted">Hint: Leave blank if you don't have one registered yet.</div>
                                <span asp-validation-for="FormModel.DomainName" class="text-danger small"></span>
                            </div>

                            <!-- Message -->
                            <div class="col-12">
                                <label asp-for="FormModel.Message" class="form-label">
                                    Anything we should know?
                                </label>
                                <textarea asp-for="FormModel.Message" class="form-control" rows="3" placeholder="Tell us about your traffic requirements, existing host, or software stack..."></textarea>
                                <span asp-validation-for="FormModel.Message" class="text-danger small"></span>
                            </div>

                            <!-- Consent Checkbox -->
                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="FormModel.Consent" class="form-check-input" type="checkbox" required />
                                    <label asp-for="FormModel.Consent" class="form-check-label text-secondary small">
                                        I agree to be contacted about my cloud server request and understand my inquiry will be routed to the SuperCloudServer engineering team. <span class="required-star">*</span>
                                    </label>
                                </div>
                                <span asp-validation-for="FormModel.Consent" class="text-danger small d-block"></span>
                            </div>

                            <!-- Submit Button -->
                            <div class="col-12 text-center mt-4">
                                <button type="submit" class="btn btn-primary-scs btn-lg px-5 py-3 fs-5" id="submitBtn">
                                    <span>Get Started</span> <i class="bi bi-arrow-right"></i>
                                </button>
                                <div class="mt-3 text-secondary small">
                                    <i class="bi bi-shield-check text-success me-1"></i> 30-Day Money-Back Guarantee · No long-term lock-in · Immediate confirmation
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     14. FREQUENTLY ASKED QUESTIONS (FAQS)
     ========================================================================= -->
<section class="py-5" id="faq">
    <div class="container py-4">
        <div class="section-header">
            <span class="section-tag">Got Questions?</span>
            <h2 class="section-title">Frequently Asked Questions</h2>
            <p class="section-subtitle">
                Clear, transparent answers about our cloud architecture, payment options, backups, and migration support.
            </p>
        </div>

        <!-- FAQ Search Input -->
        <div class="faq-search-wrapper">
            <i class="bi bi-search faq-search-icon"></i>
            <input type="text" id="faqSearch" class="form-control form-control-lg faq-search-input" placeholder="Search FAQs (e.g., VPS, backups, upgrade, SSH)..." />
        </div>

        <!-- FAQ Category Filter Pills -->
        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
            <button type="button" class="btn btn-sm btn-outline-primary faq-cat-pill active rounded-pill px-3" data-category="All">All FAQs</button>
            <button type="button" class="btn btn-sm btn-outline-primary faq-cat-pill rounded-pill px-3" data-category="General">General</button>
            <button type="button" class="btn btn-sm btn-outline-primary faq-cat-pill rounded-pill px-3" data-category="Plans & Billing">Plans & Billing</button>
            <button type="button" class="btn btn-sm btn-outline-primary faq-cat-pill rounded-pill px-3" data-category="Technical">Technical</button>
            <button type="button" class="btn btn-sm btn-outline-primary faq-cat-pill rounded-pill px-3" data-category="Security & Support">Security & Migration</button>
        </div>

        <!-- FAQ Accordion -->
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="accordion accordion-scs" id="faqAccordion">
                    @for (int i = 0; i < Model.Faqs.Count; i++)
                    {
                        var faq = Model.Faqs[i];
                        <div class="accordion-item faq-item-entry" data-category="@faq.Category">
                            <h2 class="accordion-header" id="heading-@faq.Id">
                                <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@faq.Id" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="collapse-@faq.Id">
                                    @faq.Question
                                </button>
                            </h2>
                            <div id="collapse-@faq.Id" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="heading-@faq.Id" data-bs-parent="#faqAccordion">
                                <div class="accordion-body">
                                    @faq.Answer
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

