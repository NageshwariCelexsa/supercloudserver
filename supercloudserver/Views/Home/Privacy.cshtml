@{
    ViewData["Title"] = "Privacy Policy | SuperCloudServer";
}

<section class="py-5 bg-light">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-9 bg-white p-5 rounded-4 border shadow-sm">
                <span class="section-tag mb-3">Legal & Transparency</span>
                <h1 class="fw-bold mb-3">Privacy Policy</h1>
                <p class="text-secondary small mb-4">Last Updated: November 2026 | SuperCloudServer by Celexsa
                    Technologies</p>

                    <hr class="my-4">

                    <h4 class="fw-bold mt-4">1. Introduction</h4>
                    <p class="text-secondary">
                        SuperCloudServer, an enterprise cloud hosting division of Celexsa Technologies, respects your
                        privacy and is dedicated to protecting your personal information. This Privacy Policy details how we
                        collect, store, and utilize information provided when you visit supercloudserver.com, configure
                        cloud instances, or request support services.
                    </p>

                    <h4 class="fw-bold mt-4">2. Information We Collect</h4>
                    <ul class="text-secondary">
                        <li><strong>Contact Information:</strong> Full name, corporate email address, telephone contact
                            number, and organization details when submitting quote inquiries or registering an account.</li>
                            <li><strong>Technical Cloud Data:</strong> Requested operating system specifications (Linux or
                                Windows), storage tiers, compute configurations, domain names, and server usage metrics.</li>
                                <li><strong>Billing Details:</strong> Invoicing addresses, GSTIN numbers for input tax credit
                                    claiming, and transaction confirmation records (payment card data is securely handled via
                                    PCI-DSS certified gateways).</li>
                                </ul>

                                <h4 class="fw-bold mt-4">3. How We Use Your Data</h4>
                                <p class="text-secondary">
                                    We process your information strictly to provision and configure cloud infrastructure, execute
                                    automatic failover mechanisms, provide 24x7 customer support, process monthly or annual billing
                                    invoices, and safeguard networks against DDoS, spam, and cyber threats.
                                </p>

                                <h4 class="fw-bold mt-4">4. Data Isolation & Security</h4>
                                <p class="text-secondary">
                                    Unlike multi-tenant shared hosting platforms, SuperCloudServer guarantees hardware-isolated resource
                                    allocations. Your files sit on mirrored RAID-1 NVMe drives and are guarded by ClamAV and advanced
                                    network firewalls. We never sell, lease, or monetize your contact details or server content to third
                                    parties.
                                </p>

                                <h4 class="fw-bold mt-4">5. Contact Our Privacy Officer</h4>
                                <p class="text-secondary">
                                    If you have questions regarding this Privacy Policy or wish to request data updates, please contact
                                    us:
                                </p>
                                <div class="p-3 bg-light rounded-3 border">
                                    <p class="mb-1 fw-bold text-dark">Celexsa Technologies - Cloud Infrastructure Division</p>
                                    <p class="mb-1 text-secondary">Chennai, Tamil Nadu, India</p>
                                    <p class="mb-1 text-secondary">Phone: +91 7401 6666 33</p>
                                    <p class="mb-0 text-secondary">Email: privacy@supercloudserver.com</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
